SECRET_KEY=your-strong-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

DB_NAME=tech_track_pro
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Jobber OAuth / API ─────────────────────────────────────────────
# From the Jobber Developer Center (https://developer.getjobber.com).
JOBBER_CLIENT_ID=your-jobber-client-id
JOBBER_CLIENT_SECRET=your-jobber-client-secret
# Must EXACTLY match the OAuth callback URL registered on your Jobber app.
JOBBER_REDIRECT_URI=http://localhost:8000/v1/jobber/callback/
# Space-separated scopes you requested and were approved for.
JOBBER_SCOPES=read_clients read_jobs
# GraphQL API version pin (X-JOBBER-GRAPHQL-VERSION).
JOBBER_API_VERSION=2025-04-16
# Where the callback sends the browser after connecting (your frontend).
JOBBER_CONNECT_SUCCESS_URL=http://localhost:5173/jobber/connected
JOBBER_CONNECT_FAILURE_URL=http://localhost:5173/jobber/failed

# ── Stripe ─────────────────────────────────────────────────────────
# Test-mode (sandbox) values only in development. Never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Leave empty to use the version pinned in settings.py.
STRIPE_API_VERSION=

# ── Email ──────────────────────────────────────────────────────────
# Defaults to the console backend (prints, sends nothing). Any SMTP provider works.
# Left commented out: an empty value is not a valid number or boolean.
# EMAIL_BACKEND=
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=
# DEFAULT_FROM_EMAIL=
# Frontend origin used in emailed links.
# APP_BASE_URL=
# Seconds a password-reset link stays valid.
# PASSWORD_RESET_TIMEOUT=
