SECRET_KEY=your-strong-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

DB_NAME=tech_track_pro
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Jobber OAuth / API ─────────────────────────────────────────────
# From the Jobber Developer Center (https://developer.getjobber.com).
JOBBER_CLIENT_ID=your-jobber-client-id
JOBBER_CLIENT_SECRET=your-jobber-client-secret
# Must EXACTLY match the OAuth callback URL registered on your Jobber app.
JOBBER_REDIRECT_URI=http://localhost:8000/v1/jobber/callback/
# Space-separated scopes you requested and were approved for.
JOBBER_SCOPES=read_clients read_jobs
# GraphQL API version pin (X-JOBBER-GRAPHQL-VERSION).
JOBBER_API_VERSION=2025-04-16
# Where the callback sends the browser after connecting (your frontend).
JOBBER_CONNECT_SUCCESS_URL=http://localhost:5173/jobber/connected
JOBBER_CONNECT_FAILURE_URL=http://localhost:5173/jobber/failed
